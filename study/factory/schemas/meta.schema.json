{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stagnes307.github.io/study/factory/schemas/meta.schema.json",
  "title": "Study Factory Lesson Metadata",
  "type": "object",
  "required": [
    "version",
    "course_id",
    "lesson_id",
    "title",
    "slug",
    "section_id",
    "section_title",
    "unit_id",
    "unit_title",
    "lesson_group_id",
    "lesson_group_title",
    "topics",
    "artifacts",
    "published_at",
    "status"
  ],
  "properties": {
    "version": {"const": 2},
    "course_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "lesson_id": {"type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*-[1-9][0-9]*-[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "section_id": {"type": "string"},
    "section_title": {"type": "string"},
    "unit_id": {"type": "string"},
    "unit_title": {"type": "string"},
    "lesson_group_id": {"type": "string"},
    "lesson_group_title": {"type": "string"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "required": ["ff", "cc"],
      "properties": {
        "ff": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "cc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      },
      "additionalProperties": false
    },
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "enum": [
        "pending",
        "ff-running",
        "ff-complete",
        "cc-running",
        "cc-complete",
        "publishing",
        "published",
        "failed"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "published"}}},
      "then": {
        "properties": {
          "published_at": {"type": "string", "format": "date-time"},
          "artifacts": {
            "properties": {
              "ff": {"$ref": "#/$defs/artifact"},
              "cc": {"$ref": "#/$defs/artifact"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["producer", "prompt_profile", "generated_at", "sha256"],
      "properties": {
        "producer": {
          "enum": [
            "ailey-bailey-custom-gpt",
            "openai-codex"
          ]
        },
        "prompt_profile": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
